# ---- required ----
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=            # run: make chat-id   (after messaging your bot once)

# ---- optional, big accuracy wins ----
BESTBUY_API_KEY=             # free at developer.bestbuy.com -> exact US stock, no scraping
UNBLOCKER=                   # scraperapi | scrapingbee | zyte | brightdata
UNBLOCKER_KEY=               # unlocks the ~24 bot-walled retailers

# ---- optional, off by default ----
PS5WATCH_LLM_FALLBACK=0      # 1 = let Claude Haiku re-read pages the parsers can't
ANTHROPIC_API_KEY=
PS5WATCH_STATE=              # defaults to ~/.local/state/ps5watch/state.json
